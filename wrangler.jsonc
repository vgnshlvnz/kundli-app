{
  "name": "kundli-app",
  "main": "src/worker.js",
  "compatibility_date": "2024-10-15",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  },
  "run_worker_first": ["/api/*"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kundli-locations",
      "database_id": "TODO-REPLACE-WITH-DATABASE-ID"
    }
  ]
}
